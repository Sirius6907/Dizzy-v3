<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ builds its own splash from the SplashScreen API, ignoring
         the layer-list. Pin it to the same near-black as the Flutter brand
         intro so tap-to-first-frame reads as one continuous frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>

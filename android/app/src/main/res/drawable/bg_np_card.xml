<?xml version="1.0" encoding="utf-8"?>
<!-- The "now playing" card shell. RemoteViews cannot draw gradients or
     shadows, so the depth comes from a solid ink surface, a hairline border
     and generous corner rounding — the same language the app uses in Flutter. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF0E1118" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start window. Near-black, matching the Flutter brand intro, so the
     handoff from the OS splash to the first Flutter frame has no white flash.
     The launcher mark is centred at its intrinsic size (~48dp). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
